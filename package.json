{
  "name": "biblioteca-tdt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:local": "wrangler d1 execute biblioteca-tdt --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute biblioteca-tdt --remote --file=./schema.sql",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/worker.js && node --check src/core.js && node --check public/app.js && node --check 'functions/api/[[path]].js'"
  },
  "devDependencies": {
    "wrangler": "^4.43.0"
  }
}
